# Mapbox public token (pk.…). Required for maps to load.
# Create one at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=

# Plausible site domain (must match the domain in your Plausible site settings).
# Example: pdxtraffic.com
VITE_PLAUSIBLE_DOMAIN=

# ODOT TripCheck Data API subscription key (server/build only — never VITE_).
# https://apiportal.odot.state.or.us/ → TripCheck Data product
TRIPCHECK_API_KEY=
