{
  "name": "pdxtraffic",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Every ODOT traffic camera in Oregon on one map. Kept weird.",
  "scripts": {
    "dev": "vite",
    "fetch-incidents": "node scripts/fetch-incidents.mjs",
    "prebuild": "npm run fetch-incidents",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@plausible-analytics/tracker": "^0.4.6",
    "mapbox-gl": "^3.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/rubik-dirt": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
